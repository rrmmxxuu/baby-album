WEB_IMAGE=ghcr.io/rrmmxxuu/baby-album-web
API_IMAGE=ghcr.io/rrmmxxuu/baby-album-api
IMAGE_TAG=main

WEB_PORT=3000
API_PORT=18080
POSTGRES_PORT=15432

POSTGRES_DB=baby_album
POSTGRES_USER=baby_album
POSTGRES_PASSWORD=replace-me

API_ADDR=:8080
DATABASE_URL=postgres://baby_album:replace-me@postgres:5432/baby_album?sslmode=disable

INTERNAL_API_BASE_URL=http://baby-album-api:8080
NEXT_PUBLIC_API_BASE_URL=https://album-api.example.com
PUBLIC_API_BASE_URL=https://album-api.example.com
MEDIA_URL_SIGNING_SECRET=replace-with-a-long-random-secret

MAX_UPLOAD_MB=512
BLOB_STORAGE_MAX_GB=50
BLOB_STORAGE_TARGET_GB=35
ORIGINAL_HOT_MIN_RETENTION_DAYS=30
BLOB_MAINTENANCE_INTERVAL_MINUTES=15

R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_MAX_GB=8
R2_TARGET_GB=6
R2_CLASS_A_SOFT_LIMIT=800000
R2_CLASS_B_SOFT_LIMIT=8000000

ALLOWED_ORIGINS=https://album.example.com
