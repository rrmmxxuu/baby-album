NEXT_PUBLIC_API_BASE_URL=https://album-api.example.com
WEB_IMAGE=ghcr.io/rrmmxxuu/baby-album-web
API_IMAGE=ghcr.io/rrmmxxuu/baby-album-api
IMAGE_TAG=main

WEB_PORT=3000
API_PORT=18080
POSTGRES_PORT=15432

POSTGRES_DB=baby_album
POSTGRES_USER=baby_album
POSTGRES_PASSWORD=replace-me

API_ADDR=:8080
DATABASE_URL=postgres://baby_album:replace-me@postgres:5432/baby_album?sslmode=disable
CACHE_ROOT=/var/lib/baby-album/cache
MAX_UPLOAD_MB=512

ALLOWED_ORIGINS=https://album.example.com
