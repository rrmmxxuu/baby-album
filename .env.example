## Local development defaults only.
## For VPS deployment use deploy/vps/.env.example.
## For NAS agent deployment use deploy/agent/.env.example.

INTERNAL_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
PUBLIC_API_BASE_URL=http://localhost:8080
MEDIA_URL_SIGNING_SECRET=dev-media-secret

WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432

API_ADDR=:8080
DATABASE_URL=postgres://baby_album:baby_album@localhost:5432/baby_album?sslmode=disable
CACHE_ROOT=tmp/cache
MAX_UPLOAD_MB=512
BLOB_STORAGE_MAX_GB=50
BLOB_STORAGE_TARGET_GB=35
ORIGINAL_HOT_MIN_RETENTION_DAYS=30
BLOB_MAINTENANCE_INTERVAL_MINUTES=15

R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_LOCAL_ROOT=tmp/r2
R2_MAX_GB=8
R2_TARGET_GB=6
R2_CLASS_A_SOFT_LIMIT=800000
R2_CLASS_B_SOFT_LIMIT=8000000

ALLOWED_ORIGINS=http://localhost:3000

AGENT_API_BASE_URL=http://localhost:8080
AGENT_NODE_NAME=Local NAS
AGENT_NODE_ID=
AGENT_NODE_TOKEN=
AGENT_PAIRING_CODE=
AGENT_REGISTRATION_TOKEN=
AGENT_HEARTBEAT_INTERVAL=15s
AGENT_LIBRARY_ROOT=tmp/library
